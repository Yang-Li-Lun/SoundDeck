# Public source allowlist. New top-level content requires explicit review.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/app/
!/gradle/
!/docs/
!/tools/

/docs/*
!/docs/PROTOCOL.md
!/docs/LE_AUDIO.md
!/docs/DEVICE_TEST.md
!/docs/VALIDATION.md
!/docs/LICENSING.md
/tools/*
!/tools/build.ps1
!/tools/start-emulator.ps1
!/tools/test-emulator.ps1
!/tools/verify-ui-smoke.ps1
!/tools/verify-launcher.py
/gradle/*
!/gradle/wrapper/
!/gradle/licenses/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# Local SDKs, emulators, reference checkouts, evidence and APK deliveries stay local.
.local/
.reference/
evidence/
deliverables/
.gradle/
.kotlin/
.ipc/
.idea/
.vscode/
**/build/
local.properties
*.iml
.DS_Store
Thumbs.db

